# The admin API renders article art and icons at publish time with
# libjpeg-turbo's cjpeg (the baseline 4:4:4 JFIF the console accepts), so
# the image is no longer scratch. Pinning the Alpine release pins cjpeg.
FROM docker.io/library/alpine:3.22
RUN apk add --no-cache libjpeg-turbo-utils && cjpeg -version
COPY newscdn /newscdn
ENTRYPOINT ["/newscdn"]
