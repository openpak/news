# Required. PostgreSQL connection for the news content.
NEWS_DATABASE_URL=postgres://news:secret@localhost:5432/news

# Required, >=32 chars. Shared credential for the authoring gRPC; every RPC
# fails closed without it (metadata: authorization: Bearer <key> or x-operator-key).
NEWS_OPERATOR_KEY=change-me-operator-change-me-operator!

# Console-visible base URL for images and dataset URLs, e.g. the bcat-data
# host the Switch adapter terminates (contract request NB-1).
NEWS_PUBLIC_BASE_URL=https://bcat-data-lp1.cdn.nintendo.net

# Listen addresses (ports.md block 20040: +0 HTTP, +1 gRPC, +2 metrics).
NEWS_HTTP_ADDR=:20040
NEWS_GRPC_ADDR=:20041
NEWS_METRICS_ADDR=:20042

# Filesystem object store root for images and dataset files.
NEWS_OBJECTS_DIR=./data/objects
